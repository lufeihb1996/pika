{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://mcp-mac.id96.vip/api/:path*"},
    {"source": "/media/:path*", "destination": "https://mcp-mac.id96.vip/media/:path*"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"}]}
  ]
}
